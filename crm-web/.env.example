# En producción debe ser exactamente /api/v1 para conservar la cookie same-origin.
# En desarrollo puede apuntar al API local.
VITE_API_BASE_URL=http://localhost:4100/api/v1

# local usa correo/contraseña y sesión HttpOnly del API.
# demo carga fixtures sintéticos exclusivamente con el servidor de desarrollo.
# Una compilación productiva rechaza demo.
VITE_AUTH_MODE=local
