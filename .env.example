# Example environment variables for local development
# Copy to `.env` and replace the value with your preferred submission endpoint.
# For local CSV API use: VITE_SUBMISSION_ENDPOINT=http://localhost:3001/api/submit
# For local leads API use: VITE_LEADS_SUBMISSION_ENDPOINT=http://localhost:3001/api/lead-submit
VITE_POWER_AUTOMATE_ENDPOINT=
VITE_SUBMISSION_ENDPOINT=
VITE_LEADS_SUBMISSION_ENDPOINT=
# Optional when the abonados API is hosted separately. If omitted, the frontend
# derives `/api/abonados-lmp-submit` from VITE_SUBMISSION_ENDPOINT.
VITE_ABONADOS_SUBMISSION_ENDPOINT=
# Opcional: si se omite, la interfaz administrativa deriva este endpoint del anterior.
VITE_ABONADOS_EXPORT_ENDPOINT=
# Keep false until authentication is implemented and approved.
VITE_PUBLIC_FORMS_ENABLED=false
# Independent switch for `/abonados` and `/abonados-lmp-26-27`.
VITE_SUBSCRIBER_FORM_ENABLED=false

# Optional: absolute directory where CSV is stored by server.js
# Use this in hosted backends with persistent disks, e.g. Render: /var/data
CSV_DATA_DIR=
VITE_ENABLE_LOCAL_QUEUE=true

# Backend API config (`server.js`)
PORT=3001
# Keep false until authentication is implemented and approved.
PUBLIC_FORMS_ENABLED=false
# Independent backend switch for the LMP 2026-2027 subscriber form.
SUBSCRIBER_FORM_ENABLED=false
# Server-only Bearer token for protected CSV exports. Never expose as VITE_*.
CSV_EXPORT_TOKEN=
# Dedicated server-only Bearer token for the abonados CSV export. Never expose as VITE_*.
ABONADOS_CSV_EXPORT_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173
SUBMIT_RATE_LIMIT_PER_MIN=180
CSV_FLUSH_INTERVAL_MS=250
CSV_MAX_QUEUE_SIZE=10000
CSV_MAX_BATCH_SIZE=250
CSV_DEDUPE_WINDOW_MS=86400000
