# Esta herramienta SOLO permite escritura cuando el entorno es staging.
CRM_IMPORT_ENVIRONMENT=staging

# Debe cambiarse explícitamente a true además de usar --commit y --confirm-sha.
CRM_IMPORT_ALLOW_WRITE=false

# Use exclusivamente la URL de PostgreSQL staging. No use producción.
DATABASE_URL=postgresql://usuario:contrasena@host:5432/base_staging?sslmode=require

# UUID del usuario administrador que ejecuta y queda responsable del lote.
CRM_IMPORT_UPLOADED_BY=00000000-0000-0000-0000-000000000000

# Límite defensivo del archivo de entrada en bytes (50 MiB por defecto).
CRM_IMPORT_MAX_INPUT_BYTES=52428800
