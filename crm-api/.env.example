# Runtime
NODE_ENV=development
PORT=4100
TRUST_PROXY=1
LOG_LEVEL=info

# PostgreSQL (use Render Internal Database URL in production)
DATABASE_URL=postgresql://crm_user:change-me@localhost:5432/crm_abonados
DATABASE_SSL=false
DB_POOL_MAX=10

# Generate three different secrets, each with at least 32 random characters.
# Never commit their real values.
AUDIT_HASH_KEY=replace-with-a-different-random-secret-at-least-32-chars
SESSION_HASH_KEY=replace-with-a-different-random-secret-at-least-32-chars
PASSWORD_PEPPER=replace-with-a-different-random-secret-at-least-32-chars

# Exact browser origin. Production must be the HTTPS Vercel host serving the
# CRM and proxying /api/v1 to Render; do not call Render directly from JS.
CORS_ORIGINS=http://localhost:5174
LOCAL_ADMIN_DOMAIN=charrosjalisco.com
SESSION_COOKIE_SECURE=false
SESSION_ABSOLUTE_TTL_MS=28800000
SESSION_IDLE_TTL_MS=2700000

# Persistent login throttling plus bounded in-process scrypt concurrency.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_BLOCK_MS=900000
LOGIN_KDF_CONCURRENCY=2
LOGIN_KDF_QUEUE_MAX=8
# Used only for npm run bootstrap:admin or npm run reset:admin. Supply a real
# value temporarily in the command environment, then remove it immediately.
BOOTSTRAP_ADMIN_EMAIL=admin@charrosjalisco.com
BOOTSTRAP_ADMIN_NAME=Administrador CRM
BOOTSTRAP_ADMIN_PASSWORD=replace-temporarily-with-a-strong-password

# Operational limits
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
EXPORT_ROW_LIMIT=50000
